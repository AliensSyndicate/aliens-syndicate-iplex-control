<?xml version="1.0" encoding="utf-8"?>
<!-- Window background after the Android 12+ system splash leaves and until
     Flutter draws its first frame: the same icon, at the system splash size
     (288 dp, centred), on the same colour, so the logo never disappears. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/background" />
    <item
        android:width="288dp"
        android:height="288dp"
        android:gravity="center"
        android:drawable="@drawable/android12splash" />
</layer-list>
