    "zod": "^3.24.0",
    "google-auth-library": "^10.9.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "firebase": "^11.0.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
