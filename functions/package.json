{
  "name": "iplex-backend",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test test/*.test.ts",
    "test:rules": "node --import tsx --test test/*.rules.ts",
    "test:integration": "node --import tsx --test test/*.integration.ts",
    "check": "npm run build && npm test",
